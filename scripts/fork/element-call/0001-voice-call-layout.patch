+/*
+Copyright 2026 Cinny fork contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+.preview {
+  position: relative;
+  /* The layout layer ignores the pointer; take hover so the Hide Members pill shows. */
+  pointer-events: auto;
+  inline-size: 195px;
+  block-size: 112px;
+  border-radius: 8px;
+  overflow: hidden;
+  background: #000;
+  display: grid;
+  place-items: center;
+  flex-shrink: 0;
+  /* Cinny: it's a button (click to focus the stream); drop the button chrome. */
+  border: none;
+  padding: 0;
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+}
+
+.video {
+  position: absolute;
+  inset: 0;
+  inline-size: 100%;
+  block-size: 100%;
+  object-fit: cover;
+  opacity: 0.5;
+  filter: blur(2px);
+}
+
+.icon {
+  position: relative;
+  color: #fff;
+}
+
+.live {
+  position: absolute;
+  inset-block-start: 8px;
+  inset-inline-end: 8px;
+  padding: 2px 6px;
+  border-radius: 4px;
+  background: #f23f43;
+  color: #fff;
+  font-size: 11px;
+  font-weight: 700;
+  line-height: 14px;
+  text-transform: uppercase;
+}
+
+.name {
+  position: absolute;
+  inset-block-end: 8px;
+  inset-inline-start: 8px;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  max-inline-size: calc(100% - 16px);
+  padding: 2px 8px;
+  border-radius: 6px;
+  background: rgb(0 0 0 / 0.55);
+  color: #fff;
+  font-size: 14px;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+/* Cinny: the grid layout's stream tile, sized like the other grid tiles. */
+.gridTile {
+  inline-size: var(--width);
+  block-size: var(--height);
+  border-radius: var(--cpd-space-4x);
+}
+
+.gridTile .video {
+  object-fit: contain;
+  opacity: 1;
+  filter: none;
+}
+
+.gridTile .icon {
+  display: none;
+}
+
+.gridTile .name {
+  inset-block-end: var(--cpd-space-3x);
+  inset-inline-start: var(--cpd-space-3x);
+}
