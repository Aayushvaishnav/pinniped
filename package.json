{
  "name": "pinniped",
  "version": "4.12.6",
  "description": "Yet another matrix client",
  "desktopName": "pinniped.desktop",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build:element-call": "node scripts/fork/element-call/build.mjs",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "npm run check:eslint && npm run check:prettier",
    "check:eslint": "eslint src/*",
    "check:prettier": "prettier --check .",
    "fix:prettier": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "commit": "git-cz",
    "bump": "node scripts/update-version.js",
    "electron:start": "electron electron/main.cjs",
    "electron:dist": "npm run build && electron-builder --config electron/electron-builder.yml --linux",
    "electron:dist:win": "npm run build && electron-builder --config electron/electron-builder.yml --win",
    "electron:dist:mac": "npm run build && electron-builder --config electron/electron-builder.yml --mac"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint",
    "*": "prettier --ignore-unknown --write"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [],
  "author": "Ajay Bura",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "1.1.6",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "1.3.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "1.0.3",
    "@fontsource/inter": "4.5.14",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-virtual": "3.14.23",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.3.0",
    "@vanilla-extract/vite-plugin": "3.7.1",
    "await-to-js": "3.0.0",
    "badwords-list": "2.0.1-4",
    "blurhash": "2.0.5",
    "browser-encrypt-attachment": "0.3.0",
    "chroma-js": "3.2.0",
    "classnames": "2.5.1",
    "dateformat": "5.0.5",
    "dayjs": "1.11.23",
    "domhandler": "5.0.3",
    "emojibase": "17.0.0",
    "emojibase-data": "17.0.0",
    "file-saver": "2.0.5",
    "focus-trap-react": "10.0.2",
    "folds": "2.7.3",
    "html-dom-parser": "4.0.0",
    "html-react-parser": "4.2.0",
    "i18next": "23.12.2",
    "i18next-browser-languagedetector": "8.2.3",
    "i18next-http-backend": "2.5.2",
    "immer": "9.0.16",
    "is-hotkey": "0.2.1",
    "jotai": "2.6.0",
    "jszip": "3.10.2",
    "linkify-react": "4.4.0",
    "linkifyjs": "4.4.0",
    "lucide-react": "1.63.0",
    "matrix-js-sdk": "41.7.0",
    "matrix-widget-api": "1.16.1",
    "millify": "6.1.0",
    "pdfjs-dist": "4.10.38",
    "prismjs": "1.30.0",
    "react": "18.2.0",
    "react-aria": "3.53.1",
    "react-blurhash": "0.2.0",
    "react-colorful": "5.8.1",
    "react-dom": "18.2.0",
    "react-error-boundary": "4.0.13",
    "react-google-recaptcha": "2.1.0",
    "react-i18next": "15.0.0",
    "react-range": "1.10.0",
    "react-router-dom": "6.30.3",
    "sanitize-html": "2.18.1",
    "slate": "0.123.0",
    "slate-dom": "0.123.0",
    "slate-history": "0.113.1",
    "slate-react": "0.123.0",
    "ua-parser-js": "1.0.35"
  },
  "devDependencies": {
    "@element-hq/element-call-embedded": "0.20.1",
    "@esbuild-plugins/node-globals-polyfill": "0.2.3",
    "@playwright/test": "1.64.1",
    "@rollup/plugin-inject": "5.0.5",
    "@rollup/plugin-wasm": "6.2.2",
    "@types/chroma-js": "3.1.3",
    "@types/file-saver": "2.0.7",
    "@types/is-hotkey": "0.1.10",
    "@types/node": "18.11.18",
    "@types/prismjs": "1.26.6",
    "@types/react": "18.2.39",
    "@types/react-dom": "18.2.17",
    "@types/react-google-recaptcha": "2.1.9",
    "@types/sanitize-html": "2.16.2",
    "@types/ua-parser-js": "0.7.39",
    "@typescript-eslint/eslint-plugin": "5.46.1",
    "@typescript-eslint/parser": "5.46.1",
    "@vitejs/plugin-react": "4.2.0",
    "buffer": "6.0.3",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "17.4.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "eslint": "8.29.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.0",
    "husky": "9.1.7",
    "lint-staged": "16.3.2",
    "prettier": "2.8.1",
    "react-test-renderer": "18.2.0",
    "typescript": "5.9.3",
    "vite": "5.4.19",
    "vite-plugin-pwa": "0.20.5",
    "vite-plugin-static-copy": "1.0.4",
    "vitest": "2.1.9"
  }
}
